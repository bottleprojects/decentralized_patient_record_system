# ── App Environment ──────────────────────────────────────────────────────────
# Use 'development' for local SQLite fallback, or 'production' to enforce hosted PostgreSQL
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Encryption (AES-256-GCM) ────────────────────────────────────────────────
# Generate with: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here

# ── Authentication ──────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-32-byte-secret-key-here
# Optional: Automated bootstrap credentials for the system administrator (/admin dashboard)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-secure-admin-password


# ── Allowed Frontend Origin(s) ───────────────────────────────────────────────
# In production, specify your hosted frontend domain (comma-separated if multiple, no wildcard '*')
FRONTEND_URL=https://my-app.vercel.app

# ── Blockchain (Sepolia) ─────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
PRIVATE_KEY=your-wallet-private-key-hex
CONTRACT_ADDRESS=0xYourDeployedContractAddress
# Set to true ONLY in local dev if you want to bypass blockchain transactions. NEVER true in production.
SIMULATE_BLOCKCHAIN=false
# Maximum on-chain transactions per day to protect faucet wallet
MAX_DAILY_TRANSACTIONS=50

# ── IPFS / Pinata ────────────────────────────────────────────────────────────
# Create a free account at https://app.pinata.cloud
# Go to API Keys → New Key → check "pinFileToIPFS" → generate
PINATA_API_KEY=your-pinata-api-key
PINATA_API_SECRET=your-pinata-api-secret
# Optional: use your own Pinata dedicated gateway (free tier works with public gateway)
PINATA_GATEWAY=https://gateway.pinata.cloud

# ── File Upload Size Limit & Memory Footprint ────────────────────────────────
# Maximum file upload size in MB (default: 10 in production).
# Memory use during an upload is ~3x-3.5x the file size:
# original raw bytes in memory (1x) + encrypted ciphertext buffer (1x) + multipart HTTP request body (~1-1.5x).
# Setting this to 10 MB caps peak memory usage to ~35 MB, safely within Render free tier (512 MB).
MAX_UPLOAD_MB=10
